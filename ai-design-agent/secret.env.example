# Copy this file to `secret.env` and fill in your own values.
# Get a free Gemini API key at: https://aistudio.google.com/apikey
# `secret.env` is gitignored — never commit real keys.

GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash

# Similarity score (0-1) the visual reviewer must hit before the loop stops early.
SIMILARITY_THRESHOLD=0.72

# Hard cap on generate -> review -> judge loops per run.
MAX_ITERATIONS=2

# Where generated Next.js projects (and uploaded reference images) are written.
GENERATED_OUTPUT_DIR=./generated-output

# Backend port (used by `python -m backend.main` direct-run mode).
BACKEND_PORT=8000

# Used only to render a percentage in the UI's quota indicator — NOT a real limit
# enforced by Google. Free-tier daily request caps (RPD) vary by model/account;
# check https://ai.google.dev/gemini-api/docs/rate-limits and set to your plan.
GEMINI_DAILY_QUOTA_ESTIMATE=250

# Minimum seconds enforced between consecutive Gemini calls, so one generation
# run doesn't burst past the free tier's per-minute rate limit. 6s ~= 10 rpm.
GEMINI_MIN_INTERVAL_SECONDS=6

# When true, generated sites may use real placeholder photos from picsum.photos
# for image-heavy references. When false (default), imagery is recreated as CSS
# "mock" cards so the site stays fully self-contained (no external network).
ALLOW_PLACEHOLDER_IMAGES=false
